{
    "name": "bubble-toolbar",
    "version": "0.1.0",
    "description": "Floating, responsive, blurred glass toolbar component for React 18 and 19 with group-based circular and pill layouts.",
    "author": "",
    "license": "MIT",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "typecheck": "tsc --noEmit",
        "storybook": "storybook dev -p 6006 --disable-telemetry",
        "build-storybook": "storybook build --disable-telemetry",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix --max-warnings=0",
        "format": "biome check --write .",
        "format:check": "biome check .",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm test -- --runInBand"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@storybook/addon-docs": "^10.6.2",
        "@storybook/react": "^10.6.2",
        "@storybook/react-vite": "^10.6.2",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.13.1",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.13.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "storybook": "^10.6.2",
        "super-configs": "^1.26.1",
        "ts-jest": "^29.2.5",
        "tsup": "^8.3.6",
        "typescript": "^5.7.3",
        "vite": "8.3.4"
    }
}
