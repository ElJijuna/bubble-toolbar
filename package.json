{
    "name": "bubble-toolbar",
    "version": "0.1.0",
    "description": "Floating, responsive, blurred glass toolbar component for React 18 and 19 with group-based circular and pill layouts.",
    "author": "ElJijuna",
    "license": "MIT",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css"
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "tsup",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "typecheck": "tsc --noEmit",
        "storybook": "storybook dev -p 6006 --disable-telemetry",
        "build-storybook": "storybook build --disable-telemetry",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix --max-warnings=0",
        "format": "biome check --write .",
        "format:check": "biome check .",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm test -- --runInBand",
        "prepack": "npm run build",
        "release": "node scripts/release.mjs",
        "release:dry-run": "semantic-release --dry-run --no-ci",
        "commitlint": "commitlint"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.10",
        "@semantic-release/npm": "^13.2.0",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "@storybook/addon-docs": "^10.6.2",
        "@storybook/react": "^10.6.2",
        "@storybook/react-vite": "^10.6.2",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.13.1",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^6.1.2",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "eslint": "^10.13.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "semantic-release": "^25.0.9",
        "storybook": "^10.6.2",
        "super-configs": "^1.26.1",
        "ts-jest": "^29.2.5",
        "tsup": "^8.3.6",
        "typescript": "^5.7.3",
        "vite": "8.3.4"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ElJijuna/bubble-toolbar.git"
    },
    "homepage": "https://eljijuna.github.io/bubble-toolbar/",
    "bugs": {
        "url": "https://github.com/ElJijuna/bubble-toolbar/issues"
    },
    "publishConfig": {
        "access": "public"
    }
}
